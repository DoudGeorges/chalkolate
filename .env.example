# Chalkolate configuration defaults
# Keep GEMINI_API_KEY exclusively on the backend. Never expose it via VITE_* variables.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Set GEMINI_DEEP_MODEL to an empty string to disable Deep Mode
GEMINI_DEEP_MODEL=gemini-4-hydrogen

# Product heuristic threshold (not a calibrated probability)
ANALYSIS_CONFIDENCE_THRESHOLD=0.85

# Backend concurrency, deadlines, and token budgets
ANALYSIS_MAX_CONCURRENCY=2
ANALYSIS_TIMEOUT_SECONDS=30
ANALYSIS_DEEP_TIMEOUT_SECONDS=60
ANALYSIS_MAX_OUTPUT_TOKENS=4096
ANALYSIS_DEEP_MAX_OUTPUT_TOKENS=8192

# Upload & image geometry limits
MAX_UPLOAD_BYTES=10485760
MAX_METADATA_BYTES=16384
MAX_IMAGE_PIXELS=25000000
MAX_MODEL_LONG_EDGE=1280

# Comma-separated explicit origins for cross-origin access (empty = same-origin / Vite proxy only)
CORS_ALLOWED_ORIGINS=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
