# Chalkolate configuration defaults
# Keep GEMINI_API_KEY and ELEVENLABS_API_KEY server-side only. Never expose them via VITE_* or NEXT_PUBLIC_* variables.
# The Next.js API routes (frontend/src/app/api) read these from the process env: set them as Vercel env vars, or run
# `vercel env pull frontend/.env.local` for local dev (Next only loads .env files from frontend/, not the repo root).
# The legacy Python backend still reads the repo-root .env until it is deleted.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Reasoning depth: minimal (lowest latency & token cost), low, medium, or high
GEMINI_THINKING_LEVEL=low

# ElevenLabs text-to-speech configuration (optional; browser speech synthesis is used as fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4_turbo
ELEVENLABS_VOICE_ID=

# Product heuristic threshold (not a calibrated probability)
ANALYSIS_CONFIDENCE_THRESHOLD=0.85

# Backend concurrency, deadline, and token budget
ANALYSIS_MAX_CONCURRENCY=2
ANALYSIS_TIMEOUT_SECONDS=20
ANALYSIS_MAX_OUTPUT_TOKENS=4096
SPEECH_TIMEOUT_SECONDS=10
SPEECH_MAX_CONCURRENCY=2
SPEECH_RATE_LIMIT_PER_MINUTE=30

# Upload & image geometry limits (1600 preserves dense handwriting legibility)
MAX_UPLOAD_BYTES=10485760
MAX_METADATA_BYTES=16384
MAX_IMAGE_PIXELS=25000000
MAX_MODEL_LONG_EDGE=1600

# Comma-separated explicit origins for cross-origin access (empty = same-origin / Vite proxy only)
CORS_ALLOWED_ORIGINS=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
