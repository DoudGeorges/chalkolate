# Process variables take precedence over root .env and server/.env.
# Set provider keys on the server. Keep them out of NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

# Optional. Browser speech is available without ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4_turbo
ELEVENLABS_VOICE_ID=

# Gemini attempt timeout for analysis and total deadline for notes, in seconds.
ANALYSIS_TIMEOUT_SECONDS=12
ANALYSIS_MAX_CONCURRENCY=2
ANALYSIS_MAX_OUTPUT_TOKENS=4096
ANALYSIS_CONFIDENCE_THRESHOLD=0.85
NOTES_TIMEOUT_SECONDS=40
NOTES_MAX_CONCURRENCY=1
NOTES_MAX_OUTPUT_TOKENS=6144

SPEECH_TIMEOUT_SECONDS=10
SPEECH_MAX_CONCURRENCY=2
SPEECH_RATE_LIMIT_PER_MINUTE=30

# On Vercel, use MAX_UPLOAD_BYTES=4194304 to leave room for multipart metadata.
MAX_UPLOAD_BYTES=10485760
MAX_METADATA_BYTES=16384
MAX_IMAGE_PIXELS=25000000
MAX_MODEL_LONG_EDGE=1600

# Optional list of explicit origins for cross-origin clients. Same-origin clients can leave it empty.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO
