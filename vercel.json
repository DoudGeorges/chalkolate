{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{node_modules/**,.next/**,src/**,public/**,experiments/**,server/tests/**,.venv/**,.claude/**,.git/**}"
    }
  }
}
